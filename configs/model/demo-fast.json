{
    "_description": "Fast demo config — uses the KG-enhanced network with relaxed thresholds and fewer epochs. Requires Reactome + STRING data but runs significantly faster than the main config. Good for initial exploration.",
    "gcn": false,
    "trainable_mask": false,
    "full_train": false,
    "use_bias": true,
    "penalty": 0.001,
    "optimizer": "adam",
    "activation": "tanh",
    "add_unk_genes": false,
    "epoch": 100,
    "shuffle": true,
    "batch_size": 64,
    "class_weight": "auto",
    "reduce_lr_after_nepochs": {"drop": 0.25, "epochs_drop": 30},
    "lr": 0.001,
    "max_f1": false,
    "feature_important_name": "deeplift",
    "baseline": "zero",
    "topk_per_layer": 10,
    "network": "reactome_protein_kg",
    "use_kg": true,
    "min_shared_proteins": 3,
    "min_shared_ratio": 0.1,
    "use_dynamic_threshold": true,
    "filter_hub_proteins": true,
    "hub_threshold": 50,
    "max_hub_proteins": 3,
    "max_mediators_per_edge": 10,
    "n_hidden_layers": 2,
    "dropout": [0.5, 0.1, 0.1, 0.1, 0.1],
    "loss_weights": [2, 7, 20, 54]
}
