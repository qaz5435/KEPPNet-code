{
    "_description": "Minimal demo config — fast to run, suitable for verifying the pipeline works. Uses pure Reactome network (no PPI or KG data required).",
    "gcn": false,
    "trainable_mask": false,
    "full_train": false,
    "use_bias": true,
    "penalty": 0.001,
    "optimizer": "adam",
    "activation": "tanh",
    "add_unk_genes": false,
    "epoch": 50,
    "shuffle": true,
    "batch_size": 32,
    "class_weight": "auto",
    "reduce_lr_after_nepochs": {"drop": 0.5, "epochs_drop": 20},
    "lr": 0.001,
    "max_f1": false,
    "feature_important_name": "deeplift",
    "baseline": "zero",
    "topk_per_layer": 5,
    "network": "reactome",
    "n_hidden_layers": 2,
    "dropout": [0.5, 0.1, 0.1, 0.1, 0.1],
    "loss_weights": [2, 7, 20, 54]
}
